# MOEX Screener v3.1 configuration
# Copy to .env and fill in your values.

# MOEX WebSocket credentials
# guest access (free, limited to candles only):
MOEX_DOMAIN=DEMO
MOEX_LOGIN=guest
MOEX_PASSCODE=guest

# Real MOEX license key (unlocks book/trades/OI via WebSocket):
# MOEX_DOMAIN=MOEX
# MOEX_LOGIN=your_key
# MOEX_PASSCODE=your_key

# Comma-separated list of equities to watch (TQBR board)
EQUITIES=SBER,GAZP,LKOH,VTBR,MGNT,ROSN,GMKN,TATN,SNGS,PLZT

# Comma-separated list of futures for the M09 Open Interest module
FUTURES=SIU6,BRU6,GDH6,MEU6

# Poll / render interval (seconds)
RENDER_SEC=5

# Thresholds
ICEBERG_VOLUME_SPIKE_PCT=2.0
ICEBERG_PRICE_TOLERANCE=0.005
ICEBERG_HISTORY_WINDOW=20
SPREAD_ALERT_THRESHOLD=0.3

# M15 Крупные деньги — day volume threshold (stocks)
FAN_VOLUME_THRESHOLD=1000000

# M08 Роботы (радар) — 6–60 sec periodic minimal strikes near the spread
# Detection via trades.json (real trade timestamps, guest access).
# ROBOT_MIN_REPEATS+ strikes at the same price, median inter-strike gap
# in [ROBOT_STRIKE_MIN_SEC, ROBOT_STRIKE_MAX_SEC], QTY <= ROBOT_QTY_MAX_FACTOR x median.
# Robot must survive ROBOT_MIN_LIFETIME_MIN minutes before showing as ACTIVE.
ROBOT_STRIKE_MIN_SEC=6
ROBOT_STRIKE_MAX_SEC=60
ROBOT_MIN_REPEATS=3
ROBOT_QTY_MAX_FACTOR=2.0
ROBOT_MIN_LIFETIME_MIN=10
SPREAD_ZONE_FACTOR=5.0
ROBOT_DB_DIR=E:/Deepseek/ReTools/moex-screener/robot_db
SOUND_ALERT_ENABLED=true

